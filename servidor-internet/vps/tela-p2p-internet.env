# /etc/tela-p2p-internet.env — configuração do servidor do modo Internet
PORT=8765
# TROQUE: IP público da VPS (o mesmo do external-ip do turnserver.conf)
TURN_HOST=IP_DA_VPS
TURN_PORT=3479
# TROQUE: o mesmo static-auth-secret do turnserver.conf (openssl rand -hex 32)
TURN_SECRET=SEGREDO_DO_TURN
# Quanto tempo vale o acesso ao TURN que cada pessoa recebe ao entrar (segundos)
TURN_TTL_SECONDS=86400
# Limites
MAX_ROOMS=200
FAIL_PER_IP=10
# 1 só se este servidor ficar atrás do Caddy/nginx (wss://). Direto na porta 8765: deixe 0.
TRUST_PROXY=0
