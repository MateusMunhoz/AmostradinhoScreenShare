{
  "name": "tela-p2p",
  "version": "1.11.13",
  "description": "Configurações e Personalização de Layout",
  "main": "boot.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --local",
    "test": "node --test tests/*.test.js",
    "test:settings": "node tests/settings-run.cjs",
    "test:rtc": "electron tests/rtc-smoke.cjs",
    "test:e2e": "node tests/e2e/rodar.js",
    "dist": "electron-builder --win portable",
    "publicar": "node publicar.js",
    "razze-api": "node razze-api/server.js",
    "test:razze-api": "node --test tests/razze-*.test.js",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.telap2p.app",
    "productName": "Tela P2P",
    "protocols": [
      {
        "name": "Convite Tela P2P",
        "schemes": [
          "telap2p"
        ]
      }
    ],
    "files": [
      "boot.js",
      "main.js",
      "main/**",
      "preload.js",
      "signaling.js",
      "github.js",
      "index.html",
      "styles.css",
      "renderer/**",
      "assets/audio/**",
      "voice.js",
      "encode-once.js",
      "pcm-worklet.js",
      "vendor/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "bin",
          "to": "bin"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "extraResources": [
      {
        "from": "pack",
        "to": "pack"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "Tela-P2P.${ext}",
      "synopsis": "Transmita a tela e converse por voz com os amigos, de PC para PC",
      "executableName": "tela-p2p"
    }
  },
  "author": "MateusMunhoz",
  "allowScripts": {
    "electron@33.4.11": true
  }
}
