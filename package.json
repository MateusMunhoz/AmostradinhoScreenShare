{
  "name": "tela-p2p",
  "version": "1.19.1",
  "description": "Configurações e Personalização de Layout",
  "main": "boot.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --local",
    "dev:teste": "electron . --local --perfil-teste",
    "test": "node --test tests/*.test.js",
    "test:settings": "node tests/settings-run.cjs",
    "test:rtc": "electron tests/rtc-smoke.cjs",
    "test:clipe": "electron tests/e2e/clipe.cjs && electron tests/e2e/clipe-faixa.cjs",
    "test:e2e": "node tests/e2e/rodar.js",
    "dist": "electron-builder --win portable",
    "dist:instalador": "electron-builder --win nsis",
    "dist:eva": "electron-builder --win portable -c.win.icon=assets/icone/tela-p2p-eva.ico",
    "dist:topgun": "electron-builder --win portable -c.win.icon=assets/icone/tela-p2p-topgun.ico",
    "publicar": "node publicar.js",
    "razze-api": "node razze-api/server.js",
    "test:razze-api": "node --test tests/razze-*.test.js",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg",
    "icone": "electron gerar-icone.js",
    "test:razze-admin": "node tests/e2e/razze-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.telap2p.app",
    "productName": "Nebula",
    "afterPack": "./icone-exe.js",
    "protocols": [
      {
        "name": "Convite Tela P2P",
        "schemes": [
          "telap2p"
        ]
      }
    ],
    "files": [
      "boot.js",
      "main.js",
      "main/**",
      "preload.js",
      "signaling.js",
      "sala-protocolo.js",
      "github.js",
      "index.html",
      "styles.css",
      "styles-estelar.css",
      "styles-arasaka.css",
      "styles-eva.css",
      "styles-dusol.css",
      "styles-diluna.css",
      "styles-renascenca.css",
      "styles-topgun.css",
      "styles-cloud.css",
      "renderer/**",
      "assets/audio/**",
      "assets/icone/**",
      "assets/fontes/**",
      "assets/temas/*.webp",
      "voice.js",
      "encode-once.js",
      "pcm-worklet.js",
      "renderer/porta-microfone.js",
      "renderer/rnnoise-vad-worklet.js",
      "vendor/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icone/tela-p2p.ico",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "bin",
          "to": "bin"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName} Instalador.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nebula",
      "uninstallDisplayName": "Nebula",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icone/tela-p2p.ico",
      "uninstallerIcon": "assets/icone/tela-p2p.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "extraResources": [
      {
        "from": "pack",
        "to": "pack"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "assets/icone/tela-p2p.png",
      "artifactName": "Tela-P2P.${ext}",
      "synopsis": "Transmita a tela e converse por voz com os amigos, de PC para PC",
      "executableName": "tela-p2p"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "assets/icone/tela-p2p.icns",
      "artifactName": "Tela-P2P-mac-${arch}.${ext}",
      "identity": null
    }
  },
  "author": "MateusMunhoz",
  "allowScripts": {
    "electron@33.4.11": true
  }
}
