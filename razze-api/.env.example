# Aponte o registro A/AAAA deste hostname para o IP público da VPS.
API_DOMAIN=api.seudominio.com

# Gere um valor novo com: openssl rand -base64 36
RAZZE_ADMIN_TOKEN=

# Entrar com Google (opcional): ID e segredo do cliente OAuth do tipo "App para computador" (passo a passo em docs/razze-api.md).
# Vazio = o botão "Entrar com Google" não aparece no app.
RAZZE_GOOGLE_CLIENT_ID=
RAZZE_GOOGLE_CLIENT_SECRET=

# Entrar com Google no app de Android (opcional): o ID do cliente OAuth do tipo "Aplicativo da web", no mesmo projeto
# do Google Cloud (não é secreto; não precisa do segredo). Vazio = o login do Android responde que está desligado.
RAZZE_GOOGLE_WEB_CLIENT_ID=
