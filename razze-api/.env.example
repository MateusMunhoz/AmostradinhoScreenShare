# Aponte o registro A/AAAA deste hostname para o IP público da VPS.
API_DOMAIN=api.seudominio.com

# Gere um valor novo com: openssl rand -base64 36
RAZZE_ADMIN_TOKEN=

# Entrar com Google (opcional): ID e segredo do cliente OAuth do tipo "App para computador" (passo a passo em docs/razze-api.md).
# Vazio = o botão "Entrar com Google" não aparece no app.
RAZZE_GOOGLE_CLIENT_ID=
RAZZE_GOOGLE_CLIENT_SECRET=

# Entrar com Google no app de Android (opcional): o ID do cliente OAuth do tipo "Aplicativo da web", no mesmo projeto
# do Google Cloud (não é secreto; não precisa do segredo). Vazio = o login do Android responde que está desligado.
RAZZE_GOOGLE_WEB_CLIENT_ID=

# E-mail (opcional; docs/spec/email-e-dois-fatores.md): códigos de confirmação, "esqueci a senha" e avisos de segurança.
# Com o Gmail: um Gmail só do app, com a verificação em duas etapas ligada, e uma "senha de app"
# (https://myaccount.google.com/apppasswords). Vazio = sem confirmação de e-mail; senha só pelo código do administrador.
RAZZE_SMTP_USER=
RAZZE_SMTP_PASS=
# Opcionais (padrão: smtp.gmail.com, 465 e o próprio RAZZE_SMTP_USER como remetente)
RAZZE_SMTP_HOST=
RAZZE_SMTP_PORT=
RAZZE_EMAIL_FROM=

# Verificação em dois fatores: chave que cifra os segredos do app autenticador no banco. Gere com: openssl rand -base64 36
# Não troque depois de ligada (quem tem o 2FA perderia o acesso). Vazio = 2FA desligado.
RAZZE_TOTP_KEY=
